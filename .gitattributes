# Normalize line endings repo-wide. core.autocrlf=true on dev machines has
# caused mixed CRLF/LF corruption in hot source files; with text=auto, git
# stores LF in the object database and checks out the platform default.
* text=auto

# Windows batch and PowerShell scripts must stay CRLF for cmd.exe/PowerShell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Binary artifacts -- never convert or treat as text.
*.exe binary
*.png binary
*.ico binary
