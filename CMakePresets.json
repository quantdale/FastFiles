{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "$env{FASTFILES_NINJA_EXE}"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "description": "Debug build via VS-bundled CMake/Ninja, no global installs required.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "Release build via VS-bundled CMake/Ninja, no global installs required.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "analyze",
      "inherits": "debug",
      "displayName": "Debug + /analyze",
      "description": "Debug build with MSVC static analysis enabled.",
      "cacheVariables": {
        "FASTFILES_STATIC_ANALYSIS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Debug + AddressSanitizer",
      "description": "Debug build with MSVC AddressSanitizer for fuzz/test runs. CMAKE_CXX_FLAGS inlines the MSVC defaults (/DWIN32 /D_WINDOWS /W3 /GR /EHsc) because preset cache variables replace compiler-default flags rather than append; /RTC1 is dropped from CMAKE_CXX_FLAGS_DEBUG (incompatible with /fsanitize=address).",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /W3 /GR /EHsc /fsanitize=address",
        "CMAKE_CXX_FLAGS_DEBUG": "/MDd /Ob0 /Od",
        "CMAKE_EXE_LINKER_FLAGS": "/INCREMENTAL:NO"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "analyze", "configurePreset": "analyze" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    }
  ]
}
