#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @FASTFILES_VERSION_COMMA@
 PRODUCTVERSION @FASTFILES_VERSION_COMMA@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@FASTFILES_COMPANY_NAME@\0"
            VALUE "FileDescription", "@FASTFILES_VERSION_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@FASTFILES_FILE_VERSION@\0"
            VALUE "InternalName", "@FASTFILES_VERSION_ORIGINAL_FILENAME@\0"
            VALUE "OriginalFilename", "@FASTFILES_VERSION_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "@FASTFILES_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@FASTFILES_PRODUCT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
