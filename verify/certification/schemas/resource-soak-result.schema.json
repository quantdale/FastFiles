{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FastFiles Resource Soak Certification Result Schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "commit",
    "tree",
    "exactTreeBound",
    "targetExecutable",
    "environment",
    "startUtc",
    "endUtc",
    "durationSeconds",
    "sampleIntervalSeconds",
    "sampleCount",
    "fastFilesPid",
    "metrics",
    "disposition"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1]
    },
    "commit": {
      "type": "string",
      "pattern": "^(?!0{40})[0-9a-fA-F]{40}$"
    },
    "tree": {
      "type": "string",
      "pattern": "^(?!0{40})[0-9a-fA-F]{40}$"
    },
    "exactTreeBound": {
      "type": "boolean"
    },
    "targetExecutable": {
      "type": "string",
      "minLength": 1
    },
    "executableHash": {
      "type": ["string", "null"],
      "pattern": "^(?!0{64})[0-9a-fA-F]{64}$"
    },
    "environment": {
      "type": "object",
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "computer": { "type": "string" },
        "powershell": { "type": "string" }
      }
    },
    "startUtc": {
      "type": "string",
      "format": "date-time"
    },
    "endUtc": {
      "type": "string",
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0
    },
    "sampleIntervalSeconds": {
      "type": "number",
      "minimum": 1
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 1
    },
    "fastFilesPid": {
      "type": "integer",
      "minimum": 1
    },
    "enginePid": {
      "type": ["integer", "null"]
    },
    "metrics": {
      "type": "object",
      "required": [
        "workingSetBytes",
        "handles",
        "threads",
        "gdiObjects",
        "userObjects"
      ],
      "properties": {
        "workingSetBytes": { "$ref": "#/definitions/metricStat" },
        "privateBytes": { "$ref": "#/definitions/metricStat" },
        "handles": { "$ref": "#/definitions/metricStat" },
        "threads": { "$ref": "#/definitions/metricStat" },
        "gdiObjects": { "$ref": "#/definitions/metricStat" },
        "userObjects": { "$ref": "#/definitions/metricStat" },
        "cpuSeconds": { "$ref": "#/definitions/metricStat" }
      }
    },
    "activityTransitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestampUtc", "activity", "success"],
        "properties": {
          "timestampUtc": { "type": "string", "format": "date-time" },
          "activity": { "type": "string" },
          "success": { "type": "boolean" },
          "details": { "type": "string" }
        }
      }
    },
    "disposition": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_ENVIRONMENT",
        "TIMEOUT"
      ]
    },
    "dispositionReason": {
      "type": ["string", "null"]
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    }
  },
  "definitions": {
    "metricStat": {
      "type": "object",
      "required": [
        "baseline",
        "minimum",
        "median",
        "maximum",
        "final"
      ],
      "properties": {
        "baseline": { "type": "number" },
        "minimum": { "type": "number" },
        "median": { "type": "number" },
        "maximum": { "type": "number" },
        "final": { "type": "number" },
        "trendRatePerSecond": { "type": ["number", "null"] }
      }
    }
  }
}
