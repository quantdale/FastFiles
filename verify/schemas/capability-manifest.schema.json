{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FastFiles Verify Capability Manifest",
  "type": "object",
  "required": ["id", "interfaceVersion", "tier", "entryModule", "entryPoints"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "interfaceVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "tier": { "type": "integer" },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "entryModule": { "type": "string" },
    "entryPoints": {
      "type": "object",
      "required": ["availability", "run", "diagnostics"],
      "properties": {
        "availability": { "type": "string" },
        "run": { "type": "string" },
        "diagnostics": { "type": "string" },
        "baseline": { "type": "string" },
        "repairHints": { "type": "string" }
      }
    }
  }
}
