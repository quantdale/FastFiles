{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FastFiles Verify Run Manifest (Execution-Context Fingerprint)",
  "type": "object",
  "required": [
    "runId",
    "change",
    "startedAtUtc",
    "osBuild",
    "isElevated",
    "sessionId",
    "sessionKind",
    "providerId",
    "provider",
    "targetIdentity"
  ],
  "properties": {
    "runId": { "type": "string" },
    "change": { "type": "string" },
    "startedAtUtc": { "type": "string" },
    "osBuild": { "type": "string" },
    "isElevated": { "type": "boolean" },
    "sessionId": { "type": "integer" },
    "sessionKind": { "type": "string" },
    "providerId": { "type": "string" },
    "provider": {
      "type": "object",
      "required": ["id", "interfaceVersion", "targetIdentity", "supportsSnapshotRestore"],
      "properties": {
        "id": { "type": "string" },
        "interfaceVersion": { "type": "string" },
        "displayName": { "type": "string" },
        "targetIdentity": { "type": "string" },
        "supportsSnapshotRestore": { "type": "boolean" }
      }
    },
    "targetIdentity": { "type": "string" },
    "toolchain": { "type": "object" },
    "capabilityLoadDiagnostics": { "type": "array" }
  }
}
