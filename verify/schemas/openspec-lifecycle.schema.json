{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FastFiles OpenSpec lifecycle manifest",
  "type": "object",
  "required": ["schemaVersion", "kind", "changes"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [2] },
    "kind": { "type": "string", "enum": ["fastfiles-openspec-lifecycle"] },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "state", "evidence", "taskOverrides"],
        "properties": {
          "name": { "type": "string" },
          "state": { "type": "string", "enum": ["active", "completed", "superseded", "external-evidence-only", "ambiguous"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "type": "string", "enum": ["repository-path", "git-commit", "hosted-run", "note"] },
                "path": { "type": "string" },
                "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
                "runId": { "type": "string", "pattern": "^[0-9]+$" },
                "record": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          },
          "supersededBy": { "type": ["string", "null"] },
          "taskOverrides": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["task", "disposition", "categories", "status", "evidence"],
              "properties": {
                "task": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
                "disposition": { "type": "string", "enum": ["active", "external", "historical", "superseded", "mixed"] },
                "categories": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["local", "interactive", "elevated", "external-provider", "production-signing", "clean-host", "administrative"] }
                },
                "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED", "BLOCKED_ENVIRONMENT", "REQUIRED-BUT-UNAVAILABLE"] },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["repository-path", "git-commit", "hosted-run", "note"] },
                      "path": { "type": "string" },
                      "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
                      "runId": { "type": "string", "pattern": "^[0-9]+$" },
                      "record": { "type": "string" },
                      "text": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
