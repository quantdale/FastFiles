{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FastFiles project status",
  "type": "object",
  "required": ["schemaVersion", "kind", "generatedAtUtc", "git", "tests", "capabilities", "verification", "openSpec", "release", "frontier"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [2] },
    "kind": { "type": "string", "const": "fastfiles-project-status" },
    "generatedAtUtc": { "type": "string" },
    "git": { "type": "object" },
    "tests": { "type": "object" },
    "capabilities": { "type": "object" },
    "verification": { "type": "object" },
    "openSpec": {
      "type": "object",
      "required": ["status", "totalOpenTasks", "activeLocalOpenTasks", "changesWithOpenTasks", "lifecycle", "changes"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL"] },
        "totalOpenTasks": { "type": "integer" },
        "activeLocalOpenTasks": { "type": "integer" },
        "changesWithOpenTasks": { "type": "integer" },
        "lifecycle": {
          "type": "object",
          "required": ["status", "schemaVersion", "source", "errors", "structuralErrors", "evidenceErrors", "semanticErrors", "entries", "integrity"],
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL"] },
            "schemaVersion": { "type": "integer" },
            "source": { "type": "string" },
            "errors": { "type": "array", "items": { "type": "string" } },
            "structuralErrors": { "type": "array", "items": { "type": "string" } },
            "evidenceErrors": { "type": "array", "items": { "type": "string" } },
            "semanticErrors": { "type": "array", "items": { "type": "string" } },
            "entries": { "type": "array", "items": { "type": "object" } },
            "integrity": {
              "type": "object",
              "required": ["status", "structuralErrors", "evidenceErrors", "semanticErrors"],
              "properties": {
                "status": { "type": "string", "enum": ["PASS", "FAIL"] },
                "structuralErrors": { "type": "array", "items": { "type": "string" } },
                "evidenceErrors": { "type": "array", "items": { "type": "string" } },
                "semanticErrors": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "changes": { "type": "array" }
      }
    },
    "release": { "type": "object" },
    "frontier": {
      "type": "object",
      "required": ["status", "localOpen", "environmentBlocked", "providerBlocked", "productionSigningBlocked", "cleanHostElevatedBlocked", "administrativeBlocked", "mixedOpen", "historicalOpen", "supersededOpen", "ambiguousOpen", "lifecycleErrors"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL"] },
        "localOpen": { "type": "array", "items": { "$ref": "#/definitions/frontierItem" } },
        "environmentBlocked": { "type": "array" },
        "providerBlocked": { "type": "array" },
        "productionSigningBlocked": { "type": "array" },
        "cleanHostElevatedBlocked": { "type": "array" },
        "administrativeBlocked": { "type": "array" },
        "mixedOpen": { "type": "array" },
        "historicalOpen": { "type": "array" },
        "supersededOpen": { "type": "array" },
        "ambiguousOpen": { "type": "array", "items": { "$ref": "#/definitions/frontierItem" } },
        "lifecycleErrors": { "type": "array" }
      }
    }
  },
  "definitions": {
    "frontierItem": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "valid", "authoritative", "authority", "source"],
            "properties": {
              "kind": { "type": "string" },
              "valid": { "type": "boolean" },
              "authoritative": { "type": "boolean" },
              "authority": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
