{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FastFiles Verify Top-Level Run Result",
  "type": "object",
  "required": [
    "runId",
    "invocationId",
    "change",
    "status",
    "classification",
    "startedAtUtc",
    "finishedAtUtc",
    "durationMs",
    "capabilities",
    "secondaryFailures"
  ],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "invocationId": { "type": "string", "minLength": 1 },
    "change": { "type": "string" },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
    "classification": {
      "type": "string",
      "enum": [
        "PASS",
        "BLOCKED_ENVIRONMENT",
        "REQUIRED-BUT-UNAVAILABLE",
        "ASSERTION_FAILURE",
        "HARNESS_ERROR",
        "TIMEOUT",
        "CANCELLED",
        "CLEANUP_INCOMPLETE",
        "PROVIDER_FAILURE",
        "REPORT_FAILURE"
      ]
    },
    "reason": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "startedAtUtc": { "type": "string" },
    "finishedAtUtc": { "type": "string" },
    "durationMs": { "type": "number", "minimum": 0 },
    "primaryFailure": { "type": ["object", "null"] },
    "secondaryFailures": { "type": "array", "items": { "type": "object" } },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateTreeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceProvenance": {
      "type": "object",
      "required": [
        "mode",
        "repositoryId",
        "headSha",
        "treeSha",
        "branch",
        "detached",
        "sourceCleanAtStart",
        "sourceCleanAtFinish",
        "changedDuringRun",
        "exactTreeQualified",
        "startStateDigest",
        "finishStateDigest",
        "reasonCodes"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["development", "exact-tree"] },
        "repositoryId": { "type": "string", "minLength": 1 },
        "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string" },
        "detached": { "type": "boolean" },
        "sourceCleanAtStart": { "type": "boolean" },
        "sourceCleanAtFinish": { "type": "boolean" },
        "changedDuringRun": { "type": "boolean" },
        "exactTreeQualified": { "type": "boolean" },
        "startStateDigest": { "type": "string" },
        "finishStateDigest": { "type": "string" },
        "reasonCodes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capabilityId", "status", "classification"],
        "properties": {
          "capabilityId": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
          "classification": { "type": "string" },
          "reason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
