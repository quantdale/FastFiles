{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "FastFiles UIA skip reason -> primary class registry",
    "description": "Machine-readable binding of every skip reason code the windows-ui-automation-validation capability can emit to exactly one primary class from the hardening-campaign Phase 4 taxonomy. Enforced by ffverify_foreground_skip_ps_tests against the capability source.",
    "type": "object",
    "required": ["schemaVersion", "classes", "reasons"],
    "additionalProperties": false,
    "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "classes": {
            "description": "The closed primary-class enum; every reason maps to exactly one.",
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "CAPABILITY_UNAVAILABLE",
                    "AUTOMATION_LIMITATION",
                    "ENVIRONMENT_UNSUPPORTED",
                    "FLAKY",
                    "PRODUCT_DEFECT",
                    "HARNESS_DEFECT",
                    "UNKNOWN"
                ]
            }
        },
        "reasons": {
            "description": "Kebab-case skip reason code -> exactly one primary class.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": {
                "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
                    "type": "object",
                    "required": ["primaryClass"],
                    "additionalProperties": false,
                    "properties": {
                        "primaryClass": {
                            "type": "string",
                            "enum": [
                                "CAPABILITY_UNAVAILABLE",
                                "AUTOMATION_LIMITATION",
                                "ENVIRONMENT_UNSUPPORTED",
                                "FLAKY",
                                "PRODUCT_DEFECT",
                                "HARNESS_DEFECT",
                                "UNKNOWN"
                            ]
                        },
                        "canonicalCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*[A-Z0-9]$" },
                        "absenceCodes": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" }
                        },
                        "notes": { "type": "string", "minLength": 1 }
                    }
                }
            }
        }
    }
}
